set_location_assignment PIN_AB7 -to esp_tx_o
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to esp_tx_o
set_location_assignment PIN_V10 -to kill_btn_n
set_location_assignment PIN_W10 -to shock_btn_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to kill_btn_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to shock_btn_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to kill_btn_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to shock_btn_n
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top