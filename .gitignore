# .gitignore (from _proposed.gitignore, plus the additions at the end)

# ---- Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.env.*

# ---- Quartus build products (regenerated by a compile; the .qpf/.qsf/.sdc/.tcl/.sv sources stay tracked)
fpga/**/quartus/db/
fpga/**/quartus/incremental_db/
fpga/**/quartus/simulation/
fpga/**/quartus/output_files/*
# Keep the programming file of a verified build? Uncomment to track the .sof.
# !fpga/**/quartus/output_files/*.sof
*.qws
*.qarlog
greybox_tmp/
quartus_run.log
fpga/synth.log

# ---- Questa / ModelSim
fpga/**/work/
transcript
*.wlf
vsim.wlf
modelsim.ini

# ---- Editor / OS
*.bak
*.swp
*~
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# ---- Project-specific (decide before init)
# Tuning run database: large (260 KB) and regenerated by tune.py; tuning_result.json stays tracked.
slowpath/tuning/tuning.db
# Archive of superseded files: keep out of git once history exists (git replaces it), or track it for now.
_archive/
# Scratch outputs from assistant sessions.
# Claude outputs/

# ---- Added at git init (2026-11-08)
# Secrets: API keys live only on the laptop
.env
.env.*
*.pem
*.key
# Audit logs (runtime output, may contain operator names)
*audit*.jsonl
backend/audit_log.jsonl
latency_arena_adapter/audit_trading.jsonl
# Quartus / ModelSim build products and logs (any depth)
fpga/quartus/db/
fpga/quartus/incremental_db/
fpga/quartus/output_files/
fpga/**/db/
fpga/**/incremental_db/
fpga/**/output_files/
fpga/**/output/
fpga/**/sim/work/
*.log
# Python bytecode
*.pyc
# One-shot final-eval lock / output (created only when the final evaluation runs)
slowpath/tuning/final_eval.lock
