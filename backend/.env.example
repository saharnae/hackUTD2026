# ---- Option A: Nemotron NIM on your Brev GPU (see README "Brev") ----
# With `brev port-forward <instance> --port 8000:8000` running:
NVIDIA_BASE_URL=http://localhost:8000/v1
NEMOTRON_MODEL=nvidia/nemotron-3-nano
NVIDIA_API_KEY=

# ---- Option B: NVIDIA hosted API (build.nvidia.com) ----
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_API_KEY=nvapi-xxxxxxxx

NEMOTRON_THINKING=0
# Optional
FPGA_METRICS_URL=
ALERT_WEBHOOK_URL=
# 1 = run fully offline with scripted LLM + synthetic data (UI dev / demo backup)
AGENT_MOCK=0
SCENARIO_ADAPTER=mock_trading
